  "coordination_binding": {
    "mode": "event_runtime_for_preparation",
    "entry": "coordination/entry.json",
    "identity": "local_operator_attested",
    "llm_dispatch": true,
    "event_runtime_available": true,
    "activation": "automatic_per_preparation_start",
    "listener_health": "query_runtime_not_manifest",
    "context_updates": "python_event_wakeup_and_business_gates"
  },
  "preparation_dispatch_policy": {
    "default": "real_specialist_agents",
    "roles": [
      "AG2",
      "AG1",
      "AG3"
    ],
    "user_entry": "AG0",
    "routing": "automatic_event_runtime_on_preparation_start",
    "guide": "../../personal-learning-suite/specs/preparation-runtime-start.md",
    "startup_command": "start-preparation",
    "automatic_current_chat_binding": true,
    "automatic_project_runtime_initialization": true,
    "failure_policy": "report_no_model_polling_fallback"
  }
}
