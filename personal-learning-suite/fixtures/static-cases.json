{
  "synthetic": true,
  "protocol_version": "pl-contracts/0.1.0",
  "baseline": "synthetic-baseline.json",
  "description": "所有变更仅在内存应用；预期先于运行编写。失败夹具必须命中指定错误码，不以任意异常算通过。",
  "cases": [
    {"case_id": "B0-S01", "name": "要求无内容依据", "mutation": {"target": "FIX-goal", "op": "set", "path": ["requirements", 0, "content_basis_refs"], "value": []}, "expected_error": "GOAL_DUAL_SOURCE"},
    {"case_id": "B0-S02", "name": "前置无要求依据", "mutation": {"target": "FIX-goal", "op": "delete", "path": ["prerequisites", 0, "requirement_source_refs"]}, "expected_error": "GOAL_DUAL_SOURCE"},
    {"case_id": "B0-S03", "name": "判据无内容依据", "mutation": {"target": "FIX-goal", "op": "delete", "path": ["requirements", 0, "criterion", "content_basis_refs"]}, "expected_error": "GOAL_DUAL_SOURCE"},
    {"case_id": "B0-S04", "name": "缺原答不得以摘要代替", "mutation": {"target": "FIX-event", "op": "delete", "path": ["original_response"]}, "expected_error": "REQUIRED_FIELD"},
    {"case_id": "B0-S05", "name": "单轴 mastered 不属于支持状态", "mutation": {"target": "FIX-judgment", "op": "set", "path": ["support"], "value": "mastered"}, "expected_error": "JUDGMENT_AXIS"},
    {"case_id": "B0-S06", "name": "未保留判据具体修订", "mutation": {"target": "FIX-judgment", "op": "set", "path": ["criterion_revision"], "value": 2}, "expected_error": "CRITERION_REVISION"},
    {"case_id": "B0-S07", "name": "引用不存在的事件修订", "mutation": {"target": "FIX-judgment", "op": "set", "path": ["event_refs", 0, "revision"], "value": 2}, "expected_error": "BROKEN_REF"},
    {"case_id": "B0-S08", "name": "帮助与修订顺序冲突", "mutation": {"target": "FIX-event", "op": "set", "path": ["timeline", 2, "sequence"], "value": 2}, "expected_error": "TIMELINE_ORDER"},
    {"case_id": "B0-S09", "name": "同一表现复制成第二样本事件", "mutation": {"target": "FIX-event", "op": "clone", "new_id": "FIX-event-copy"}, "expected_error": "SAMPLE_DUPLICATION"},
    {"case_id": "B0-S10", "name": "AG0 常规授权不授重要复核", "mutation": {"target": "FIX-judgment", "op": "set", "path": ["decision_type"], "value": "important_review"}, "expected_error": "AUTHORITY_SCOPE"},
    {"case_id": "B0-S11", "name": "评分授权主体不匹配", "mutation": {"target": "FIX-scoring-grant", "op": "set", "path": ["grantee"], "value": "AG2"}, "expected_error": "AUTHORITY_SCOPE"},
    {"case_id": "B0-S12", "name": "候选判断不能进入已采用计划依据", "mutation": {"target": "FIX-judgment", "op": "set", "path": ["adoption", "status"], "value": "candidate"}, "expected_error": "UNADOPTED_BASIS"},
    {"case_id": "B0-S13", "name": "只接责不能声称已安排", "mutation": {"target": "FIX-need", "op": "set", "path": ["disposition", "status"], "value": "scheduled"}, "expected_error": "NEED_DISPOSITION"},
    {"case_id": "B0-S14", "name": "费用未知不能隐填零", "mutation": {"target": "FIX-budget", "op": "set", "path": ["fees", "value"], "value": 0}, "expected_error": "FACT_STATUS"},
    {"case_id": "B0-S15", "name": "待查依赖未知不能隐填无影响", "mutation": {"target": "FIX-correction", "op": "set", "path": ["unknown_dependencies", "value"], "value": []}, "expected_error": "FACT_STATUS"},
    {"case_id": "B0-S16", "name": "材料角色不能维护能力判断", "mutation": {"target": "FIX-judgment", "op": "set", "path": ["owner"], "value": "AG2"}, "expected_error": "OWNER_SCOPE"},
    {"case_id": "B0-S17", "name": "诊断不能只留原因标签", "mutation": {"target": "FIX-diagnostic", "op": "delete", "path": ["decision_branches"]}, "expected_error": "REQUIRED_FIELD"},
    {"case_id": "B0-S18", "name": "纠错不能遗漏历史判断恢复", "mutation": {"target": "FIX-correction", "op": "delete", "path": ["judgment_recovery"]}, "expected_error": "REQUIRED_FIELD"},
    {"case_id": "B0-S19", "name": "解除用途限制需要恢复依据", "mutation": {"target": "FIX-restriction", "op": "set", "path": ["status"], "value": "lifted"}, "expected_error": "RESTRICTION_RESTORE"},
    {"case_id": "B0-S20", "name": "同一操作不能被复制为另一工作单", "mutation": {"target": "FIX-work-order", "op": "clone", "new_id": "FIX-work-order-copy"}, "expected_error": "OPERATION_DUPLICATION"},
    {"case_id": "B0-S21", "name": "工作单授权收件人不匹配", "mutation": {"target": "FIX-work-order", "op": "set", "path": ["assignee"], "value": "AG2"}, "expected_error": "WORK_AUTHORITY"},
    {"case_id": "B0-S22", "name": "工作单超出接收者授权决定范围", "mutation": {"target": "FIX-work-order", "op": "set", "path": ["decision_type"], "value": "goal_design"}, "expected_error": "WORK_AUTHORITY"},
    {"case_id": "B0-S23", "name": "有限诊断不能靠 AG0 自报角色获得授权", "mutation": {"target": "FIX-diagnostic", "op": "set", "path": ["owner"], "value": "AG0"}, "expected_error": "DIAGNOSTIC_AUTHORITY"},
    {"case_id": "B0-S24", "name": "有限诊断必须引用明确授权", "mutation": {"target": "FIX-diagnostic", "op": "delete", "path": ["authorization_ref"]}, "expected_error": "DIAGNOSTIC_AUTHORITY"},
    {"case_id": "B0-S25", "name": "空授权对象范围不是全域权限", "mutation": {"target": "FIX-scoring-grant", "op": "set", "path": ["object_scope"], "value": []}, "expected_error": "AUTHORITY_SCOPE"},
    {"case_id": "B0-S26", "name": "授权判据不能引用内容源冒充目标要求", "mutation": {"target": "FIX-scoring-grant", "op": "set", "path": ["criterion_refs"], "value": [{"id": "FIX-content-source", "revision": 1}]}, "expected_error": "AUTHORITY_SCOPE"},
    {"case_id": "B0-S27", "name": "对象引用不能省略修订", "mutation": {"target": "FIX-goal", "op": "delete", "path": ["content_basis_refs", 0, "revision"]}, "expected_error": "REFERENCE_SHAPE"},
    {"case_id": "B0-S28", "name": "空原答对象不构成原件引用", "mutation": {"target": "FIX-event", "op": "set", "path": ["original_response"], "value": {}}, "expected_error": "ORIGINAL_ARTIFACT"},
    {"case_id": "B0-S29", "name": "空时序不能隐去初答和帮助", "mutation": {"target": "FIX-event", "op": "set", "path": ["timeline"], "value": []}, "expected_error": "TIMELINE_CONTENT"},
    {"case_id": "B0-S30", "name": "父任务 known 不能只有空结构", "mutation": {"target": "FIX-activity", "op": "set", "path": ["parent_task", "value"], "value": {}}, "expected_error": "PARENT_TASK"},
    {"case_id": "B0-S31", "name": "删除状态不得保留可重建载荷", "mutation": {"target": "FIX-correction", "op": "set", "path": ["unknown_dependencies"], "value": {"status": "deleted", "reason": "虚构删除范围", "content": "可重建的个人详情"}}, "expected_error": "FACT_STATUS"}
  ]
}
